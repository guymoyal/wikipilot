# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Nothing here is needed for the core loop — `wikipilot init`, `build`, and
# `serve` are fully local and require no keys at all. These are only for the
# optional assistant and for the hosted-wiki work in cloud/.

# --- Optional: the "ask the wiki" assistant (`wikipilot agent`) ---------------
# Read from the environment or a repo-root .env. Without it the chat widget
# shows a setup message instead of failing silently.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Override the model the assistant uses. Defaults to claude-haiku-4-5.
# WIKI_AGENT_MODEL=claude-haiku-4-5-20251001


# --- Maintainer only: deploying the marketing site + cloud API ----------------
# Not needed to use or develop the CLI. `wrangler` also reads its own auth from
# `wrangler login`, which is usually easier than putting a key here.
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_API_DNS=
# SUPABASE_PERSONAL_ACCESS_TOKEN=

# The Worker's own secrets live in cloud/.dev.vars for local dev, and in
# `wrangler secret put` for deployed environments — not in this file.
# See cloud/README.md.
